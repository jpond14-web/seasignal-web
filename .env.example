# SeaSignal — environment manifest.
# Copy to .env.local for local dev; set production values in Vercel.
# Placeholder values only — never commit real secrets.

# Postgres connection string used by Prisma (Supabase pooler URL in prod).
DATABASE_URL=postgresql://user:password@localhost:5432/seasignal

# Supabase project URL (public, shipped to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public API key (public, shipped to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL — used for sitemap and share/profile links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push VAPID public key (public, shipped to the browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Web Push VAPID private key — server-only, pairs with the public key above.
VAPID_PRIVATE_KEY=your-vapid-private-key

# Resend API key for transactional email.
RESEND_API_KEY=re_your_api_key

# Shared secret authorizing calls to /api/cron/* endpoints.
CRON_SECRET=generate-a-long-random-string

# Shared secret verifying incoming calls to /api/webhooks/notify-push.
WEBHOOK_SECRET=generate-a-long-random-string

# Sentry DSN for server/edge runtime error reporting.
SENTRY_DSN=https://examplekey@o0.ingest.sentry.io/0

# Sentry DSN for browser (client) error reporting.
NEXT_PUBLIC_SENTRY_DSN=https://examplekey@o0.ingest.sentry.io/0

# Sentry auth token — build-time only, for sourcemap upload.
SENTRY_AUTH_TOKEN=sntrys_your_token

# --- Provided automatically by the runtime; do not set manually -------------
# CI            — set by CI providers (used to tweak test behavior).
# NODE_ENV      — set by Next.js (development/production/test).
# NEXT_RUNTIME  — set by Next.js (nodejs/edge).
